NEXT_PUBLIC_SITE_URL=https://www.accountingtoolslab.com

# Contact form email delivery through Resend.
# Do not prefix RESEND_API_KEY with NEXT_PUBLIC_.
# Add these values to .env.local for local development and to Vercel Environment
# Variables for production. Restart npm run dev or redeploy after changing them.
# For production, CONTACT_FROM_EMAIL should use a verified sender/domain in Resend.
# onboarding@resend.dev is mainly for testing.
RESEND_API_KEY=your_resend_api_key_here
CONTACT_TO_EMAIL=accttoolslab@gmail.com
CONTACT_FROM_EMAIL=AccountingToolsLab <onboarding@resend.dev>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Optional server-side provider timeouts in milliseconds.
# Keep these server-only. Defaults are 8000 for Turnstile and 10000 for Resend.
CONTACT_TURNSTILE_TIMEOUT_MS=8000
CONTACT_RESEND_TIMEOUT_MS=10000

# Optional for self-hosting only: set true when the app is behind a trusted
# proxy that strips client-supplied forwarding headers before setting its own.
# Vercel is trusted automatically through VERCEL=1.
CONTACT_TRUST_PROXY_HEADERS=false

# Future production rate limiting:
# The current code uses an in-memory fallback for local/dev/test. For stronger
# production protection across serverless instances, wire RateLimitStore to a
# shared Redis/Vercel KV/Upstash store and keep credentials server-only.
# RATE_LIMIT_STORE=memory
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
